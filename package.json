{
  "name": "@syscli/oneclickdz",
  "version": "0.2.0",
  "description": "Typed OneClickDZ API client for Node. Mobile, internet, gift card, and payment recharges in Algeria. Server-side only.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYSCLI/oneclickdz-node.git"
  },
  "homepage": "https://github.com/SYSCLI/oneclickdz-node#readme",
  "bugs": {
    "url": "https://github.com/SYSCLI/oneclickdz-node/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "oneclickdz",
    "algeria",
    "flexy",
    "topup",
    "recharge",
    "mobilis",
    "djezzy",
    "ooredoo",
    "gift-cards",
    "api",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
